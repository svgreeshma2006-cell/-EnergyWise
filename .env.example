# ─────────────────────────────────────────────────────────────────────────────
# EnergyWise AI Agent — Environment Configuration
# Copy this file to .env and fill in your IBM credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai Credentials ────────────────────────────────────────────────
# Obtain from: https://cloud.ibm.com → watsonx.ai → Project → Manage → Credentials
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── IBM Granite Model ─────────────────────────────────────────────────────────
# Available models:
#   ibm/granite-13b-chat-v2         (recommended — chat-optimized)
#   ibm/granite-3-8b-instruct       (lighter, faster)
#   ibm/granite-20b-multilingual    (multilingual support)
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── App Configuration ─────────────────────────────────────────────────────────
APP_NAME=EnergyWise
APP_ENV=development
LOG_LEVEL=INFO

# ── Electricity Tariff Defaults ────────────────────────────────────────────────
# Default rate in INR/kWh (India average ~7.5, adjust for your state)
DEFAULT_RATE_PER_KWH=7.5
